<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        id="cordova-plugin-firebase-messaging-extension"
        version="1.0.0">
    <name>Firebase Messaging Extension</name>
    <description>Extension plugin to add hasPermission method to cordova-plugin-firebase-messaging</description>
    <license>MIT</license>

    <engines>
        <engine name="cordova" version=">=10.0.0" />
        <engine name="cordova-android" version=">=8.1.0" />
        <engine name="cordova-ios" version=">=6.0.0" />
    </engines>

    <dependency id="com.outsystems.firebase.cloudmessaging" url="https://github.com/OutSystems/cordova-outsystems-firebase-cloud-messaging.git#2.6.0" />

    <js-module src="www/FirebaseMessagingExtension.js" name="FirebaseMessagingExtension">
        <merges target="cordova.plugins.firebase.messaging" />
    </js-module>

    <platform name="android">
        <edit-config file="AndroidManifest.xml" target="/manifest" mode="merge">
            <manifest xmlns:tools="http://schemas.android.com/tools" />
        </edit-config>

        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="FirebaseMessagingExtension">
                <param name="android-package" value="com.outsystems.firebase.messaging.extension.FirebaseMessagingExtension" />
            </feature>
        </config-file>

        <source-file src="src/android/FirebaseMessagingExtension.java" target-dir="src/com/outsystems/firebase/messaging/extension" />
    </platform>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="FirebaseMessagingExtension">
                <param name="ios-package" value="FirebaseMessagingExtensionPlugin" />
            </feature>
        </config-file>

        <header-file src="src/ios/FirebaseMessagingExtensionPlugin.h" />
        <source-file src="src/ios/FirebaseMessagingExtensionPlugin.m" />
    </platform>
</plugin>
